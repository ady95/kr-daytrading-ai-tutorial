# .env.example을 .env로 복사한 뒤 값을 채우세요. .env는 절대 커밋하지 않습니다.

# paper(모의투자) 또는 real(실전투자)
KIWOOM_ENV=paper

# 키움 REST API 모의투자 앱키
KIWOOM_PAPER_APP_KEY=
KIWOOM_PAPER_APP_SECRET=
KIWOOM_PAPER_ACCOUNT_NO=

# 키움 REST API 실전투자 앱키 (12장 전까지 비워 둡니다)
KIWOOM_REAL_APP_KEY=
KIWOOM_REAL_APP_SECRET=
KIWOOM_REAL_ACCOUNT_NO=
